# mosdns v2 示例配置：复制为 .env 后按部署环境调整。
# 容器运行时解析使用 CONTAINER_DNS；DNS_CN / DNS_GLOBAL / DNS_AI 是 mosdns 的查询上游。
# 注意：docker run --env-file 会把行内注释当成值的一部分，因此本文件所有注释都单独成行。

# --- MosDNS 上游 ---
DNS_CN=119.29.29.29,223.5.5.5,114.114.114.114
# 通用默认一个全局上游。szhome 设为 8.8.8.8,1.1.1.1，并给这两个 /32 做隧道路由。
DNS_GLOBAL=8.8.8.8
# DNS_AI 留空时沿用 DNS_GLOBAL；仅需要独立 AI 出口时再设置。
DNS_AI=
# CONCURRENT_CN / CONCURRENT_GLOBAL / CONCURRENT_AI 默认等于对应上游个数，上限 3。
# 一般无需设置；需要时取消注释并填写 1..3。
# CONCURRENT_CN=
# CONCURRENT_GLOBAL=
# CONCURRENT_AI=
ECS_PRESET=
UNKNOWN_POLICY=cn_first
ENABLE_IPV6=0
FALLBACK_THRESHOLD=300
# true 会触发 mosdns v5.3.4 fallback 竞态：primary 成功后 secondary 应答仍可能先被采用
FALLBACK_STANDBY=false

# --- 容器自身联网（下载规则、custom-hosts）---
CONTAINER_DNS=119.29.29.29
# 固定内网 Gitea 的下载解析；格式：主机名:端口:IP
# jeffok.com 由 DNSPod 按线路解析，不同解析器结果不同属正常。
# 默认留空；szhome 部署设为 gitea.jeffok.com:4443:192.168.88.252
FETCH_RESOLVE=
RULES_SOURCES=https://gh-proxy.com/https://raw.githubusercontent.com/jeffok/ASN-China/release-files,https://raw.githubusercontent.com/jeffok/ASN-China/release-files,https://gitea.jeffok.com:4443/jeff/asn-china/raw/branch/release-files
CUSTOM_HOSTS_SOURCES=https://gitea.jeffok.com:4443/jeff/mosdns/raw/branch/main/rules/custom-hosts.txt
# 可选请求 Authorization 值；默认空，不会写入日志。
CUSTOM_HOSTS_AUTH=
CUSTOM_HOSTS_INTERVAL=120
RULES_PROBE_TIMEOUT=5
RULES_FETCH_TIMEOUT=60
# RULES_UPDATE_INTERVAL 仅 entrypoint 内置备用同步循环使用；正常 sync-loop 固定本地 04:30。
# RULES_UPDATE_INTERVAL=86400

# --- 规则完整性阈值（有效行数；ASN-China 尚未发布的两项默认允许为空）---
MIN_CN=80000
MIN_PROXY=15000
MIN_GFW=3000
MIN_AI=20
MIN_IP=4000
MIN_BOGUS=100
REL_FLOOR_PCT=80
CN_EXCEPTIONS_MIN=0
APPLE_CN_MIN=0

# --- 容器路径（通常无需调整）---
RULES_DIR=/etc/mosdns/rules
STATE_DIR=/data/state
MOSDNS_CONFIG=/etc/mosdns/config.yaml

# --- 缓存、监听与日志 ---
CACHE_SIZE=10240
LAZY_CACHE_TTL=120
CACHE_DUMP_FILE=/data/cache.dump
CACHE_DUMP_INTERVAL=1800
DNS_ENTRY_LISTEN=0.0.0.0:53
DNS_API_LISTEN=127.0.0.1:9091
MOSDNS_LOG_LEVEL=info
MOSDNS_LOG_FILE=/etc/mosdns/mosdns.log
DNS_ENTRY_PORT=53
EXPLAIN_DNS=127.0.0.1
TZ=Asia/Shanghai

# --- 可选 DoH；启用需挂载 certs/ 并配置证书路径 ---
DOH_ENABLED=0
DOH_CERT=/etc/mosdns/certs/fullchain.pem
DOH_KEY=/etc/mosdns/certs/privkey.pem
DOH_LISTEN=0.0.0.0:8443

# --- 应用保护参数 ---
HISTORY_KEEP=20
CANARY_PORT=15353
CANARY_API=19091
CANARY_SENTINEL=www.baidu.com
RESTART_TIMEOUT=20

# --- RouterOS BGP 联合容器（默认关闭，需独立完成隔离验证）---
# ENABLE_ROS_BGP 启用最终应答确认；BGP_EMBEDDED=1 同时启动本容器的 BGP agent。
ENABLE_ROS_BGP=0
BGP_EMBEDDED=0
# 联合模式必填，并与 BGP agent 配置中的 local_ip/next_hop 一致。
BGP_LOCAL_IP=
BGP_AGENT_CONFIG=/etc/mosdns/bgp-agent.json
# 联合模式使用 loopback，不需要 RouterOS 用户名或密码。
ROS_BGP_CONFIRM_URL=http://127.0.0.1:9080/confirm
ROS_BGP_CONFIRM_TIMEOUT_MS=6500
